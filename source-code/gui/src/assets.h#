pub fn css() -> string is
    return "/* style.css — 1:1 palette/port of source-code/gui/src/css.vala's\n   GTK CSS onto plain web CSS for silver's webview frontend. */\n\n:root {{\n    --bg-deep:    #080a0f;\n    --bg-surface: #0e1117;\n    --bg-raised:  #141920;\n    --bg-hover:   #1a2130;\n    --border-sub: #1e2535;\n    --border-act: #2a3a5c;\n    --accent:     #4a9eff;\n    --accent-dim: #1d3a6e;\n    --green:      #3ddc84;\n    --red:        #ff4a6b;\n    --yellow:     #ffb347;\n    --purple:     #c792ea;\n    --text-pri:   #d6e0f0;\n    --text-sec:   #6b7a99;\n    --text-dim:   #3a4255;\n}}\n\n* {{ box-sizing: border-box; }}\n\nhtml, body {{\n    margin: 0;\n    height: 100%;\n    background-color: var(--bg-deep);\n    color: var(--text-pri);\n    font-family: 'Rajdhani', 'Exo 2', 'DejaVu Sans', sans-serif;\n    font-size: 13px;\n}}\n\n.app-shell {{\n    display: flex;\n    flex-direction: column;\n    height: 100vh;\n}}\n\n/* ── Header ── */\n.app-header {{\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    background-color: var(--bg-surface);\n    border-bottom: 1px solid var(--border-sub);\n    padding: 14px 20px;\n    min-height: 60px;\n}}\n.title-box {{ display: flex; align-items: center; gap: 10px; }}\n.header-logo {{ color: var(--accent); opacity: 0.9; font-size: 22px; }}\n.title-col {{ display: flex; flex-direction: column; }}\n.app-title {{\n    font-size: 18px;\n    font-weight: 700;\n    color: var(--text-pri);\n    letter-spacing: 1px;\n}}\n.app-subtitle {{ font-size: 10px; color: var(--text-sec); letter-spacing: 0.5px; }}\n.header-spinner {{\n    color: var(--accent);\n    margin-left: 8px;\n    opacity: 0.25;\n    transition: opacity 150ms ease;\n}}\n.header-spinner.spinning {{\n    opacity: 1;\n    animation: spin 900ms linear infinite;\n}}\n@keyframes spin {{ from {{ transform: rotate(0deg); }} to {{ transform: rotate(360deg); }} }}\n\n/* ── Layout ── */\n.content {{ display: flex; flex: 1; min-height: 0; }}\n.sidebar-sep-v {{ width: 1px; background-color: var(--border-sub); }}\n\n/* ── Sidebar ── */\n.sidebar {{\n    display: flex;\n    flex-direction: column;\n    background-color: var(--bg-surface);\n    padding: 12px 10px;\n    min-width: 210px;\n    width: 210px;\n    overflow-y: auto;\n}}\n.section-label {{\n    font-size: 9px;\n    font-weight: 700;\n    color: var(--text-dim);\n    letter-spacing: 2px;\n    padding: 14px 8px 6px 8px;\n}}\n.section-sep {{ height: 1px; background-color: var(--border-sub); margin: 6px 0; }}\n.version-label {{ font-size: 10px; color: var(--text-dim); padding: 10px 0; }}\n.sidebar-spacer {{ flex: 1; }}\n\n/* ── Action buttons ── */\n.action-btn {{\n    border-radius: 6px;\n    padding: 9px 14px;\n    margin: 2px 0;\n    font-size: 13px;\n    font-weight: 500;\n    border: 1px solid transparent;\n    transition: all 150ms ease;\n    cursor: pointer;\n    user-select: none;\n}}\n.btn-primary {{\n    background: linear-gradient(135deg, #1a4a8a, #0e2d5a);\n    color: var(--accent);\n    border-color: var(--accent-dim);\n}}\n.btn-primary:hover {{ background: linear-gradient(135deg, #1e5299, #122f66); border-color: var(--accent); }}\n.btn-secondary {{ background-color: var(--bg-raised); color: var(--text-pri); border-color: var(--border-sub); }}\n.btn-secondary:hover {{ background-color: var(--bg-hover); border-color: var(--border-act); }}\n.btn-warning {{ background-color: #2a1f0a; color: var(--yellow); border-color: #3a2c0f; }}\n.btn-warning:hover {{ background-color: #3a2c10; border-color: var(--yellow); }}\n.btn-danger {{ background-color: #2a0a0e; color: var(--red); border-color: #3a0f12; }}\n.btn-danger:hover {{ background-color: #3a1015; border-color: var(--red); }}\n.btn-ghost {{ background-color: transparent; color: var(--text-sec); border-color: transparent; }}\n.btn-ghost:hover {{ background-color: var(--bg-raised); color: var(--text-pri); border-color: var(--border-sub); }}\n\n.install-row {{ display: flex; flex-direction: column; gap: 4px; margin: 6px 0; }}\n.pkgs-input {{\n    background-color: var(--bg-raised);\n    border: 1px solid var(--border-sub);\n    border-radius: 6px;\n    color: var(--text-pri);\n    padding: 7px 9px;\n    font-size: 12px;\n    font-family: monospace;\n}}\n.pkgs-input:focus {{ outline: none; border-color: var(--accent-dim); }}\n.install-btn {{ margin-top: 0; }}\n\n/* ── Terminal panel ── */\n.terminal-panel {{\n    display: flex;\n    flex-direction: column;\n    flex: 1;\n    min-width: 0;\n    background-color: #0a0c10;\n}}\n.terminal-header {{\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    background-color: #0d0f14;\n    border-bottom: 1px solid var(--border-sub);\n    padding: 8px 14px;\n    min-height: 36px;\n}}\n.terminal-title {{\n    flex: 1;\n    text-align: center;\n    font-size: 11px;\n    color: var(--text-dim);\n    letter-spacing: 1px;\n}}\n.wm-dot {{ font-size: 11px; margin-right: 1px; }}\n.dot-red    {{ color: #ff5f57; }}\n.dot-yellow {{ color: #ffbd2e; }}\n.dot-green  {{ color: #28ca41; }}\n\n.terminal-body {{\n    flex: 1;\n    margin: 0;\n    padding: 12px 16px;\n    overflow-y: auto;\n    white-space: pre-wrap;\n    word-break: break-word;\n    font-family: 'JetBrains Mono', 'DejaVu Sans Mono', monospace;\n    font-size: 12.5px;\n    line-height: 1.5;\n    color: var(--text-pri);\n}}\n\n/* ── Status bar ── */\n.status-bar {{\n    display: flex;\n    align-items: center;\n    gap: 16px;\n    background-color: var(--bg-surface);\n    border-top: 1px solid var(--border-sub);\n    padding: 6px 16px;\n    min-height: 32px;\n}}\n.status-container-name {{\n    font-family: monospace;\n    font-size: 11px;\n    font-weight: 700;\n    color: var(--accent);\n    letter-spacing: 0.5px;\n}}\n.status-sep {{ color: var(--text-dim); font-size: 11px; }}\n.status-image {{ font-family: monospace; font-size: 10px; color: var(--text-dim); }}\n.status-spacer {{ flex: 1; }}\n\n.status-dot {{ font-size: 10px; }}\n.status-text {{ font-size: 11px; color: var(--text-sec); text-transform: capitalize; }}\n.dot-running  {{ color: var(--green); }}\n.dot-stopped  {{ color: var(--yellow); }}\n.dot-missing  {{ color: var(--red); }}\n.dot-checking {{ color: var(--text-dim); }}\n\n/* ── <button> / <form> reset (the Solid front-end uses real form controls) ── */\nbutton.action-btn {{\n    display: block;\n    width: 100%;\n    text-align: left;\n    font-family: inherit;\n}}\nform.install-row {{ margin: 6px 0; }}\n"
end
