mod backend

;; GENERATED by `npm run build` in frontend/ — the UI (HTML + CSS + JS bundle) as strings,
;; so the statically linked binary runs from any directory and reads no files at start-up.
mod assets

;; One import is enough: `silver`'s own lib.h# does `mod app` / `mod dialog` /
;; `mod window` / `mod ipc` / `mod data`, and that mod structure gives us the
;; `app::` / `dialog::` / `data::` namespaces used below. (`bytes -> …` imports
;; were replaced by `bit -> …` when bytes was succeeded by bit.)
use "bit -> silver" from "silver"

;; H# string literals interpolate `{expr}`, so literal JSON braces are doubled.
fn ok_json(ok: bool) -> string is
    if ok is return "{{\"ok\": true}}" end
    return "{{\"ok\": false}}"
end

;; ── command handlers (fn(string) -> string, called via silver.invoke) ──

fn cmd_get_state(_args: string) -> string is
    return backend::state_json()
end

fn cmd_run(_args: string) -> string is
    return ok_json(backend::run_and_log(["run"]))
end

fn cmd_run_gamepad(_args: string) -> string is
    return ok_json(backend::run_and_log(["run", "-gamepadui"]))
end

fn cmd_run_deck(_args: string) -> string is
    return ok_json(backend::run_and_log(["run", "-steamos3", "-steamdeck"]))
end

fn cmd_create(_args: string) -> string is
    return ok_json(backend::run_and_log(["create"]))
end

fn cmd_setup(_args: string) -> string is
    return ok_json(backend::run_and_log(["setup"]))
end

fn cmd_update(_args: string) -> string is
    return ok_json(backend::run_and_log(["update"]))
end

fn cmd_stop(_args: string) -> string is
    return ok_json(backend::run_and_log(["kill"]))
end

;; Matches Vala's confirm_remove(): a native confirm dialog first,
;; `--force remove` (no extra confirmation) only if the user says yes.
fn cmd_remove(_args: string) -> string is
    if dialog::confirm("Remove Container?",
        "This will permanently delete the HackerOS-Steam container and all data inside it.") is
        return ok_json(backend::run_and_log(["--force", "remove"]))
    end
    return ok_json(false)
end

fn cmd_export(_args: string) -> string is
    return ok_json(backend::run_and_log(["export"]))
end

fn cmd_logs(_args: string) -> string is
    return ok_json(backend::run_and_log(["logs", "80"]))
end

fn cmd_status(_args: string) -> string is
    backend::clear_log()
    return ok_json(backend::run_and_log(["status"]))
end

fn cmd_clear(_args: string) -> string is
    backend::clear_log()
    return ok_json(true)
end

;; The package names arrive as `{ "pkgs": "mangohud lib32-mangohud" }` straight
;; from the Solid input signal — no more polling a DOM <input> from on_tick.
fn cmd_install(args: string) -> string is
    let pkgs: string = string_trim(data::get_str(args, "pkgs"))
    if string_len(pkgs) == 0 is
        dialog::warning("Install Packages", "Type one or more package names first.")
        return ok_json(false)
    end
    let mut install_args: [string] = ["install"]
    let names: [string] = string_split(pkgs, " ")
    let mut i: int = 0
    while i < array_len(names) is
        if string_len(names[i]) > 0 is install_args.push(names[i]) end
        i += 1
    end
    return ok_json(backend::run_and_log(install_args))
end

fn cmd_shell(_args: string) -> string is
    if !backend::open_shell_terminal() is
        dialog::error("Open Shell", "No terminal emulator found on this system.")
        return ok_json(false)
    end
    return ok_json(true)
end

;; ── on_tick: the only place that can reach the App, hence `app::emit` ──

fn sync(a: app::App) -> app::App is
    let snapshot: string = backend::take_state_if_changed()
    if string_len(snapshot) > 0 is
        app::emit(a, "steam://state", snapshot)
    end
    return a
end

fn main() is
    backend::ensure_files()
    backend::refresh_status()

    let mut a = app::new("HackerOS Steam", 960, 680)
    a = app::load_html_str(a, assets::html())   ;; index.html + the esbuild bundle in an inline <script>
    a = app::load_css_str(a, assets::css())

    a = app::command(a, "get_state", cmd_get_state)
    a = app::command(a, "cmd_run", cmd_run)
    a = app::command(a, "cmd_run_gamepad", cmd_run_gamepad)
    a = app::command(a, "cmd_run_deck", cmd_run_deck)
    a = app::command(a, "cmd_create", cmd_create)
    a = app::command(a, "cmd_setup", cmd_setup)
    a = app::command(a, "cmd_update", cmd_update)
    a = app::command(a, "cmd_stop", cmd_stop)
    a = app::command(a, "cmd_remove", cmd_remove)
    a = app::command(a, "cmd_export", cmd_export)
    a = app::command(a, "cmd_logs", cmd_logs)
    a = app::command(a, "cmd_status", cmd_status)
    a = app::command(a, "cmd_clear", cmd_clear)
    a = app::command(a, "cmd_install", cmd_install)
    a = app::command(a, "cmd_shell", cmd_shell)

    a = app::set_tick_interval(a, 250)
    a = app::on_tick(a, sync)
    app::run(a)
end
