[package]
-> name        => hackeros-steam-tui
-> version     => 0.5.0
-> description => HackerOS Steam — terminal UI front-end for hackeros-steam
-> authors     => ["HackerOS Team <hackeros068@gmail.com>"]
-> license     => GPL-3.0
-> lang        => h#

[edition]
-> edition => 2026

[layout]
-> src => src

[build]
-> link => static

[default-build]
-> profile => release
-> target  => h#
-> emit    => bin

[dependencies]
-> tui => newest
