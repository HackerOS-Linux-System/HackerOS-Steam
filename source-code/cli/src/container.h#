;; ──────────────────────────────────────────────
;;  INSTALL EXTRA PACKAGES
;; ──────────────────────────────────────────────

fn valid_pkg(name: string) -> bool is
    let allowed: string = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@._+-"
    let n: int = string_len(name)
    if n == 0 is return false end
    let mut i: int = 0
    while i < n is
        if !string_contains(allowed, string_slice(name, i, i + 1)) is return false end
        i += 1
    end
    return true
end

pub fn install_packages(packages: [string]) is
    ui::print_header("Installing Packages")
    ;; the names are pasted into a `bash -c` string inside the container — refuse anything that
    ;; is not a plain pacman package name (no spaces, quotes, ;, $, &, | …) instead of passing it on
    let mut k: int = 0
    while k < array_len(packages) is
        if !valid_pkg(packages[k]) is
            ui::print_error("Invalid package name: '" + packages[k] + "'")
            exit(1)
        end
        k += 1
    end
    if !exists() is
        ui::print_error("Container does not exist — create it first.")
        exit(1)
    end
    ui::print_info("Packages: " + iter_join(packages, ", "))
    run_in_container("sudo pacman -S --noconfirm --needed " + iter_join(packages, " "), false)
    ui::print_success("Done — " + to_string(array_len(packages)) + " package(s) installed.")
end

