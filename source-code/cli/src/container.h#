    end
end


;; ──────────────────────────────────────────────
;;  DOCTOR  (host diagnostics — why won't create/run work?)
;; ──────────────────────────────────────────────

fn tool_row(label: string, bin: string, required: bool) -> bool is
    let p: string = process::which(bin)
    if string_len(p) > 0 is
        ui::print_status_row(label, ui::g_ok() + " " + p, colors::bright_green())
        return true
    end
    if required is
        ui::print_status_row(label, ui::g_err() + " not found", colors::red())
    else is
        ui::print_status_row(label, ui::g_warn() + " not found (optional)", colors::yellow())
    end
    return false
end

pub fn doctor() is
    ui::print_header("Host Diagnostics")
    let mut problems: int = 0

    if !tool_row("distrobox:", "distrobox", true) is problems += 1 end
    let has_podman: bool = tool_row("podman:", "podman", false)
    let has_docker: bool = tool_row("docker:", "docker", false)
    if !has_podman && !has_docker is
        ui::print_status_row("container engine:", ui::g_err() + " need podman or docker", colors::red())
        problems += 1
    end
    tool_row("distrobox-export:", "distrobox-export", false)
    tool_row("nvidia-smi:", "nvidia-smi", false)

    let drm: string = string_trim(process::run("ls /dev/dri 2>/dev/null | head -n 3 | tr '\\n' ' '"))
    if string_len(drm) > 0 is
        ui::print_status_row("GPU (/dev/dri):", ui::g_ok() + " " + drm, colors::bright_green())
    else is
        ui::print_status_row("GPU (/dev/dri):", ui::g_warn() + " no render node (games will be slow)", colors::yellow())
    end

    let wl: string = string_trim(process::run("printf '%s' \"$WAYLAND_DISPLAY\""))
    let x11: string = string_trim(process::run("printf '%s' \"$DISPLAY\""))
    if string_len(wl) > 0 || string_len(x11) > 0 is
        ui::print_status_row("Display:", ui::g_ok() + " " + wl + " " + x11, colors::bright_green())
    else is
        ui::print_status_row("Display:", ui::g_err() + " no WAYLAND_DISPLAY / DISPLAY", colors::red())
        problems += 1
    end

    ui::print_status_row("Container:", status_word(), colors::bright_white())
    write("")
    if problems == 0 is
        ui::print_success("No problems found.")
    else is
        ui::print_error(to_string(problems) + " problem(s) found - fix them before create/run.")
    end
    write("")
end

