use "std -> env" from "env"

pub fn plain() -> bool is
    if env::get("HACKEROS_STEAM_PLAIN") == "1" is return true end
    if env::get("NO_COLOR") != "" is return true end
    return false
end

fn esc(code: string) -> string is
    if plain() is return "" end
    return "\x1b[" + code + "m"
end

pub fn reset() -> string is return esc("0") end
pub fn bold() -> string is return esc("1") end
pub fn dim() -> string is return esc("2") end
pub fn italic() -> string is return esc("3") end
